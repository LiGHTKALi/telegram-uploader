{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-file-uploader",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "vars": {
    "OWNER_ID": "SET_OWNER_TELEGRAM_ID"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UPLOADER",
        "class_name": "Uploader"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Uploader"]
    }
  ]
}
